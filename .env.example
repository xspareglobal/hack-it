# ============================================================
# Instagram Mock — Environment Variables
# ============================================================
# Copy this file to .env (or .env.local) and fill in the values.
# For Vercel deployment, add each of these under
# Project Settings → Environment Variables.

# ---- DATABASE ----
# Your Neon Postgres connection string.
# Find it at: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-YOUR-PROJECT.aws.neon.tech/neondb?sslmode=require

# ---- SESSIONS ----
# Random long string used to sign JWT cookies. Generate one with:
#   openssl rand -base64 32
# Or use any random 40+ character string.
JWT_SECRET=replace-with-a-long-random-string

# ---- EMAIL (SMTP) — for sending OTP codes ----
# Get an App Password from https://myaccount.google.com/apppasswords
# (requires 2FA enabled on your Google account).
# Regular Gmail passwords will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM="Instagram Demo <your-email@gmail.com>"
